# Copie para .env.local e preencha. O .env.local nao vai para o git.
#
# EXPO_PUBLIC_* e embutido no bundle: e publico por natureza. Nada aqui e segredo.
# O Client Secret do OAuth vive so no painel do Supabase, nunca no app.

EXPO_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=000000000000-xxxxxxxx.apps.googleusercontent.com

# O cliente OAuth do tipo Android nao aparece aqui: ele e identificado pelo pacote
# com.joaodotvitor.habits mais o SHA-1 do build. Os dois clientes ficam registrados no
# Supabase, em Authentication -> Providers -> Google.
